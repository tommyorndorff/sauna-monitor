# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is git-ignored — never commit real credentials.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# ESPHome native API encryption key. Generate a real one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# OTA update password (any strong string).
ota_password: "your-ota-password"
